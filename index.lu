// Variables
let name = "Luma";
let age = 10;
const isReady = true;

log(name);
log(age);
log(isReady);

// Arithmetic
let x = 5;
let y = 10;
let sum = x + y;
let product = x * y;
log(sum)
log(product)

// Boolean and condition
if (x > y) {
    log("x is bigger")
} else {
    log("x is smaller or equal")
}

// Function
fn add(a, b) {
    return a + b
}
let result = add(7, 3)
log(result)

// Loop
loop (let i = 0; i < 5; i = i + 1) {
    log(i)
}

// Array
let nums = [1, 2, 3, 4, 5]
log(nums[0])
log(nums[2])

// Object
let user = {name: "Luma", age: 1}
log(user.name)
log(user.age)

// Conditional inside function
fn checkNumber(n) {
    if (n > 10) {
        return "Big"
    } else {
        return "Small"
    }
}

log(checkNumber(5))
log(checkNumber(15))

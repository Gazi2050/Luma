// 1. Variables & Types
let name = "Luma";
const version = 1;
let isReady = true;

// 2. Objects & Arrays
let user = { name: name, age: version };
let nums = [10, 20, 30];

log("Hello " + user.name);
log(nums[0]);
log(len(nums));

// 3. Math & Comparisons
let result = (10 + 2) * 3;
log(result > 30); // true

// 4. Functions
fn greet(n) {
    if (len(n) > 0) {
        return "Hi, " + n;
    }
    return "Hi, guest";
}
log(greet(user.name));

// 5. Loops
loop (let i = 0; i < 3; i = i + 1) {
    log(i);
}
